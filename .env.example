# --- Database ---
# Port 5433, not 5432: on many dev machines a local Postgres (Homebrew, Postgres.app)
# already owns 5432 and silently swallows the container connection. See docker-compose.yml.
DATABASE_URL="postgresql://kedu:kedu@localhost:5433/kedu?schema=public"

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
# Must be the WABA that actually owns WHATSAPP_PHONE_NUMBER_ID above — a Meta Business
# Manager / system-user token can have access to more than one WABA (e.g. a leftover
# test-number WABA alongside the real one), and pointing this at the wrong one costs
# nothing for plain message sends but breaks anything WABA-scoped, like Flows: a Flow
# created/published under the wrong WABA ID fails to send with a misleading
# "(#131009) flow_id is invalid" error, even though the flow itself is genuinely
# PUBLISHED. If unsure which WABA is correct, check an inbound webhook payload's
# entry[].id — that's the WABA the number actually lives under — and confirm with
# GET /{that_id}/phone_numbers.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret from the Meta App dashboard — signs inbound webhook payloads
# (X-Hub-Signature-256). Left blank, WhatsappSignatureGuard logs a loud warning and
# accepts unsigned requests anyway, so local testing doesn't require a real Meta app;
# set this before pointing a real WhatsApp number at the webhook.
WHATSAPP_APP_SECRET=
# Pre-approved Meta message template name for the window-open proactive nudge
# (PRD #13, post-v0) — used only outside the 24h free-form window. Template
# approval happens in Meta Business Manager, not in code; leave blank in dev —
# the nudge just no-ops with a log line for any user outside the 24h window.
WHATSAPP_WINDOW_OPEN_TEMPLATE_NAME=
# Trust Moment KYC popup form (BVN/NIN + DOB + email) — a WhatsApp Flow, so this data
# collection step never goes through free text or the AI. The Flow JSON lives at
# docs/whatsapp-flows/kyc-verification.json; create + publish it once per WABA via the
# Graph API (POST /{waba_id}/flows -> POST /{flow_id}/assets -> POST /{flow_id}/publish)
# and put the resulting flow id here. Left blank, OnboardingService logs a warning and
# tells the user the form isn't set up yet instead of silently hanging.
WHATSAPP_KYC_FLOW_ID=

# --- Rubies Microfinance (RubiesSme BaaS) ---
# Confirmed against the live OpenAPI spec at api-sme-dev.rubies.ng/v3/api-docs/BAAS-API.
# Endpoints are stage-scoped (/{stage}/baas-wallet/..., /{stage}/baas-transaction/...) —
# the dev docs only expose the dev host, confirm the live/prod host once an account exists.
RUBIES_BASE_URL=https://api-sme-dev.rubies.ng
RUBIES_STAGE=dev
# Sent as the raw Authorization header value — Rubies does NOT use a "Bearer" prefix.
RUBIES_API_KEY=
# The webhook signing secret (whsec_...), issued once alongside the API key — verifies
# the X-Webhook-Signature header on inbound /webhooks/rubies callbacks.
RUBIES_SECRET_KEY=
# "true" short-circuits every RubiesService call with deterministic fake responses —
# no live account needed for local dev/testing. Leave unset/false once real credentials exist.
RUBIES_DRY_RUN=true

# Destination account for override fees (early-access/borrow) collected from users —
# TransferConfirmationService.sweepFeeToFeesAccount sends the fee here as a separate
# transfer once the main transfer executes. Left blank, fee collection is skipped with
# a loud warning per transaction (the fee is still shown/tracked in OverrideHistory,
# it just doesn't get physically moved anywhere until this is set).
RUBIES_FEES_ACCOUNT_NUMBER=
# Defaults to Rubies MFB's own CBN code — only set this if the fees account lives at a
# different bank.
RUBIES_FEES_BANK_CODE=

# --- AI model(s) — split per the classification-vs-conversation decision ---
# "stub" (default) never calls a real provider — deterministic canned replies, safe for
# local dev/tests with no API key. "anthropic" was the first real provider wired
# (Claude's tool-use maps directly onto the structured-output guardrail pattern this app
# depends on). "openrouter" is an OpenAI-compatible gateway in front of many models,
# including free-tier ones — see the OPENROUTER_* block below. "gemini" calls Google's
# native generateContent API directly — see the GEMINI_*/GOOGLE_API_KEY block below.
# Adding another provider is a class alongside anthropic-llm.service.ts /
# openrouter-llm.service.ts / gemini-llm.service.ts; nothing else in the app depends on
# which one is active.
AI_PROVIDER=stub
CLASSIFIER_MODEL_API_KEY=
CONVERSATION_MODEL_API_KEY=
CLASSIFIER_MODEL_NAME=claude-haiku-4-5-20251001
CONVERSATION_MODEL_NAME=claude-sonnet-5

# --- OpenRouter (only used when AI_PROVIDER=openrouter) ---
# One shared key covers both roles (OpenRouter doesn't key auth per-model the way the
# Anthropic classifier/conversation key pair can). OPENROUTER_FAST_MODEL is used for the
# classifier role, OPENROUTER_MODEL for the conversation role — mirrors the
# CLASSIFIER_MODEL_NAME/CONVERSATION_MODEL_NAME split above. Free-tier models (":free"
# suffix) cost nothing but are rate-limited and noticeably weaker at structured tool-call
# extraction and persona tone than Claude — fine to prototype against, worth swapping to
# a paid OpenRouter model (or AI_PROVIDER=anthropic) before relying on this for real use.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Google Gemini (only used when AI_PROVIDER=gemini) ---
# One shared key covers both roles (Gemini doesn't key auth per-model). GEMINI_FAST_MODEL
# is used for the classifier role, GEMINI_MODEL for the conversation role — same split as
# OPENROUTER_FAST_MODEL/OPENROUTER_MODEL above. Called directly against Gemini's native
# generateContent REST API (function calling via functionDeclarations), not the
# OpenAI-compatibility shim.
GOOGLE_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Core discipline engine defaults (overridable per-user in DB) ---
DAILY_WINDOW_START_HOUR=11
DAILY_WINDOW_END_HOUR=20
EARLY_ACCESS_FLAT_FEE=1000
EARLY_ACCESS_PERCENT_FEE=0.002
BORROW_FLAT_FEE=1000
BORROW_PERCENT_FEE=0.004
SETTINGS_CHANGE_MIN_DAYS=7
# How long after filing a settings-change request before "the managers" send their
# initial substantive reply (PRD §7: "a real delay is part of the design... even a
# few hours"). Separate from and in addition to SETTINGS_CHANGE_MIN_DAYS above.
MANAGER_INITIAL_REPLY_DELAY_HOURS=3

PORT=3000
