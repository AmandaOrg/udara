{
  "name": "kedu",
  "version": "0.1.0",
  "description": "Kedu — strict, proactive financial agent on WhatsApp (v0)",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node scripts/start-prod.js",
    "start:dev": "nest start --watch",
    "start:prod": "node scripts/start-prod.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "e2e": "ts-node --project e2e/tsconfig.json e2e/run.ts",
    "e2e:smoke": "ts-node --project e2e/tsconfig.json e2e/run.ts --tag smoke",
    "orchestrator:cli": "ts-node -r tsconfig-paths/register src/cli/orchestrator-cli.ts",
    "orchestrator:golden": "ts-node -r tsconfig-paths/register src/cli/orchestrator-cli.ts --golden",
    "orchestrator:fixture": "ts-node -r tsconfig-paths/register src/cli/run-fixture.ts",
    "email:resend-monthly": "ts-node -r tsconfig-paths/register src/cli/resend-monthly-summary-cli.ts",
    "docs:check": "node scripts/check-docs.js",
    "security:check": "node scripts/check-security.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@prisma/client": "^5.10.0",
    "prisma": "^5.10.0",
    "axios": "^1.6.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "expect": "^29.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
