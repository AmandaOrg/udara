# Copy to repo root as `.env.e2e` (gitignored). Merged over `.env` for the e2e runner.
# The Nest server should also run with WHATSAPP_DRY_RUN=true and RUBIES_DRY_RUN=true.

E2E_BASE_URL=http://127.0.0.1:3000

# Same DB the running server uses (assert reads).
# DATABASE_URL=postgresql://kedu:kedu@localhost:5433/kedu?schema=public
# Or override only for the runner:
# E2E_DATABASE_URL=postgresql://kedu:kedu@localhost:5433/kedu?schema=public

# Must match the server's WHATSAPP_WEBHOOK_VERIFY_TOKEN for verify scenarios.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=e2e-verify-token

# Leave blank for local unsigned webhook acceptance (WhatsappSignatureGuard).
WHATSAPP_APP_SECRET=

# Leave blank for local unsigned Rubies webhook acceptance.
RUBIES_SECRET_KEY=

# Server-side (set these in the process running `npm run start:dev`):
# WHATSAPP_DRY_RUN=true
# RUBIES_DRY_RUN=true
# AI_PROVIDER=stub

# Opt-in: free-text orchestrator scenarios that call a real LLM.
# E2E_ORCHESTRATOR_LIVE=1
