generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IncomeType {
  SALARIED
  FOUNDER
  MULTIPLE_STREAMS
}

enum BudgetMethod {
  FLAT
  PERCENTAGE
}

enum IncomePosture {
  RESTRICT // normal path: enforce tighter spending discipline
  GROW     // income-tier branch: not enough room to restrict further
}

enum OnboardingStage {
  DISCOVERY
  WELCOME
  IDENTITY
  MONEY_STORY
  AI_REFLECTION
  STRUCTURED_QUESTIONS
  PLAN_PROPOSED
  ACCOUNT_CREATED
  FUNDED
  FIRST_TRANSACTION
  COMPLETE
}

enum TransactionType {
  NORMAL        // inside window, within today's allowance
  EARLY_ACCESS  // outside 11am-8pm window
  BORROWED      // against future allowance
}

enum TransactionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  EXECUTED
  FAILED
  CANCELLED
}

enum RecipientLabel {
  RENT
  FOOD
  VENDOR
  OTHER
}

// The interactive (button/list-driven, non-AI) "send money" wizard's
// in-progress state — deliberately separate from ConversationSession, which
// is the AI-chat persona's history. This is a deterministic step machine,
// same design principle as OnboardingSession's stage field.
enum TransferDraftStep {
  AWAITING_AMOUNT
  AWAITING_ACCOUNT_NUMBER
  AWAITING_BANK_SELECTION
  AWAITING_LABEL_SELECTION // only reached for a brand-new recipient
}

enum TransferDraftStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SettingsChangeType {
  WINDOW_HOURS
  OVERRIDE_FEES
  EXIT_RESTRICTIONS
  OTHER
}

enum SettingsChangeStatus {
  PENDING
  ELIGIBLE_FOR_REVIEW
  APPROVED
  REJECTED
}

enum WhatsappMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappMessageType {
  TEXT
  BUTTON_REPLY
  LIST_REPLY
  // A WhatsApp Flow submission (interactive.nfm_reply) — the deterministic,
  // non-AI popup-form path for collecting KYC details (BVN/NIN + DOB +
  // email) at the Trust Moment. See OnboardingService.handleInboundFlowReply.
  FLOW_REPLY
  AUDIO
  IMAGE
  DOCUMENT
  LOCATION
  STATUS
  UNKNOWN
}

enum WhatsappMessageStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum ConversationPersona {
  KEDU
  MANAGER
}

enum ConversationSessionStatus {
  ACTIVE
  CLOSED
}

enum LlmCallPurpose {
  ONBOARDING_EXTRACTION
  CONVERSATION_REPLY
  MANAGER_REPLY
  TRANSFER_INTENT_PARSE
  INTENT_CLASSIFICATION
  OTHER
}

enum RubiesWebhookEventType {
  TRANSFER_STATUS
  INCOMING_CREDIT
  UNKNOWN
}

enum NudgeType {
  WINDOW_OPEN
  DAILY_SUMMARY
  BORROW_WARNING
  SETTINGS_ELIGIBLE
  HABIT_FORMING_FOLLOWUP // onboarding script stage 13 — ~10h after onboarding completes, once ever
  OTHER
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid())
  whatsappNumber    String   @unique
  rubiesAccountId   String?  @unique

  // Identity captured during onboarding (Identity/AI Reflection stages, onboarding script)
  name              String?
  occupation        String?
  city              String?
  dateOfBirth       DateTime? // collected at the Trust Moment specifically — Rubies KYC needs a real DOB, not just age

  // Legal name as entered on the Trust Moment KYC form (WhatsApp Flow) — kept
  // separate from `name` above, which is the friendly name from onboarding
  // chat and may not match the BVN/NIN record exactly. Rubies' 90%
  // name-similarity KYC match is against firstName/lastName only — it has no
  // middle-name field — so legalMiddleName is stored for our own records but
  // never sent to Rubies.
  legalFirstName    String?
  legalMiddleName   String?
  legalLastName     String?
  email             String?

  // Financial profile (captured at onboarding — section 7 / 7a of PRD)
  monthlyIncome     Decimal? @db.Decimal(14, 2)
  incomeType        IncomeType?
  incomePosture     IncomePosture @default(RESTRICT)
  budgetMethod      BudgetMethod  @default(FLAT)
  budgetPercentage  Decimal?      @db.Decimal(5, 4) // used when budgetMethod = PERCENTAGE
  flatDailyAmount   Decimal?      @db.Decimal(14, 2) // used when budgetMethod = FLAT, set at PLAN_PROPOSED
  strictnessLevel   Int?          // user-chosen strictness, 1-5 or similar scale

  // The stated goal captured at onboarding — quoted back by the Manager persona (section 7)
  statedGoal        String?
  statedGoalSetAt   DateTime?

  // Discipline window (defaults from env, overridable per-user)
  windowStartHour   Int      @default(11)
  windowEndHour     Int      @default(20)

  // Deliberate exit (PRD 4.1) — set only by ManagerConversationService once an
  // EXIT_RESTRICTIONS SettingsChangeRequest is APPROVED. While set, AllowanceService
  // bypasses window/fee enforcement entirely — this is what "account returns to
  // normal" means mechanically.
  disciplineExitedAt DateTime?

  // KYC fields required by Rubies wallet provisioning — exactly one of bvn/nin is used.
  bvn               String?
  nin               String?

  // Rubies wallet details returned by create-wallet — distinct from rubiesAccountId
  // (=customerId): accountNumber/accountName are what fund-transfer actually debits.
  rubiesAccountNumber String? @unique
  rubiesAccountName   String?
  rubiesBankCode      String?

  // Drives the WhatsApp 24h free-form-vs-template send decision.
  lastInboundMessageAt DateTime?

  onboardingStage   OnboardingStage @default(DISCOVERY)
  onboardingCompletedAt DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dailyAllowances   DailyAllowance[]
  transactions      Transaction[]
  recipients        Recipient[]
  transferDrafts    TransferDraft[]
  overrides         OverrideHistory[]
  settingsRequests  SettingsChangeRequest[]
  onboardingSessions OnboardingSession[]
  whatsappMessages  WhatsappMessage[]
  conversationSessions ConversationSession[]
  llmCallLogs       LlmCallLog[]
  incomingCredits   IncomingCredit[]
  nudgeLogs         NudgeLog[]
}

// One row per user per calendar day — the heart of the discipline engine.
model DailyAllowance {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  date            DateTime @db.Date
  weekStartDate   DateTime @db.Date // Monday of the ISO week this allowance belongs to

  amountAllocated Decimal  @db.Decimal(14, 2)
  surplusCarriedIn Decimal @default(0) @db.Decimal(14, 2) // free rollover from prior day, same week only
  amountSpent     Decimal  @default(0) @db.Decimal(14, 2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]

  @@unique([userId, date])
  @@index([userId, weekStartDate])
}

model Recipient {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  accountNumber     String
  bankCode          String
  accountName       String?
  label             RecipientLabel @default(OTHER)

  createdAt         DateTime @default(now())

  transactions      Transaction[]

  @@unique([userId, accountNumber, bankCode])
}

model TransferDraft {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  step          TransferDraftStep
  status        TransferDraftStatus @default(ACTIVE)

  amount        Decimal? @db.Decimal(14, 2)
  accountNumber String?
  bankCode      String?
  bankName      String?
  resolvedName  String?  // from Rubies name-enquiry, shown back to the user for confirmation
  isNewRecipient Boolean @default(false)
  label         RecipientLabel?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  recipientId     String
  recipient       Recipient @relation(fields: [recipientId], references: [id])

  amount          Decimal  @db.Decimal(14, 2)
  type            TransactionType @default(NORMAL)
  status          TransactionStatus @default(PENDING_CONFIRMATION)

  feeAmount       Decimal  @default(0) @db.Decimal(14, 2)

  rubiesReference String?  // external reference once executed via Rubies

  // Idempotency / allowance-application linkage — makes recordSpend safe to call twice
  // and ties a spend to the exact button-confirm that authorized it.
  dailyAllowanceId String?
  dailyAllowance   DailyAllowance? @relation(fields: [dailyAllowanceId], references: [id])
  appliedToAllowanceAt DateTime?
  idempotencyKey  String?  @unique
  whatsappMessageId String?

  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  executedAt      DateTime?

  overrideHistory OverrideHistory?
}

// Denormalized record of every override applied — separate from Transaction
// so override behavior can be reported on independently (PRD success criteria).
model OverrideHistory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  type          TransactionType // EARLY_ACCESS or BORROWED
  feeAmount     Decimal  @db.Decimal(14, 2)
  waived        Boolean  @default(false) // true when covered by prior-day surplus

  createdAt     DateTime @default(now())
}

// The "Manager" escalation mechanic (section 7) — every settings-change
// request is timestamped against the 7-day minimum, regardless of framing.
model SettingsChangeRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  type          SettingsChangeType
  requestedChange String  // free text / structured payload describing the ask
  reason        String?  // what the user said when asked why

  requestedAt   DateTime @default(now())
  eligibleAt    DateTime // requestedAt + 7 days, computed at creation

  // PRD §7: "a real delay is part of the design... not an instant reply — even a few
  // hours... gives the impulse room to pass." Separate from and in addition to the
  // hard `eligibleAt` gate above — this governs only the initial acknowledgment reply,
  // not eligibility for a decision. Durable (DB-backed, not an in-memory timer) so it
  // survives a process restart between filing and the scheduled reply.
  initialReplyDueAt  DateTime?
  initialReplySentAt DateTime?

  status        SettingsChangeStatus @default(PENDING)
  managerNotes  String?
  resolvedAt    DateTime?
}

// Raw conversation + extracted-field state for the onboarding flow.
model OnboardingSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  stage         OnboardingStage
  messages      Json     // [{ role, content, at }]
  extractedData Json?    // partial structured data as it's confirmed

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging, AI audit trail, and Rubies inbound models
// ---------------------------------------------------------------------------

// Inbound/outbound WhatsApp message log. waMessageId is the real dedup key —
// Meta redelivers webhooks, and this unique constraint is what makes processing
// idempotent.
model WhatsappMessage {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  waMessageId    String   @unique
  direction      WhatsappMessageDirection
  type           WhatsappMessageType
  fromNumber     String
  textBody       String?
  buttonPayload  String?  // button/list id picked
  mediaId        String?  // Meta media id for audio/image/doc — plumbing only, no download in v0
  mediaMimeType  String?
  transcript     String?  // filled in by the transcription fast-follow, not v0
  flowResponseJson Json?  // parsed interactive.nfm_reply.response_json for FLOW_REPLY rows
  rawPayload     Json
  status         WhatsappMessageStatus @default(RECEIVED)
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([userId, createdAt])
}

// Post-onboarding conversation state. OnboardingSession stays dedicated to the
// stage machine; everything after COMPLETE uses this instead.
model ConversationSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  persona     ConversationPersona @default(KEDU)
  status      ConversationSessionStatus @default(ACTIVE)
  messages    Json     // rolling window, same {role,content,at} shape as OnboardingSession
  contextData Json?    // pending transfer draft, last classified intent, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

// The AI audit trail — "every output is a proposal, never a command." Every
// LlmService.complete() call is logged here, raw proposal separate from
// whatever validation/write actually happened as a result.
model LlmCallLog {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  purpose          LlmCallPurpose
  provider         String
  model            String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  rawResponse      Json     // the model's raw proposal — distinct from what was actually written
  validationResult Json?    // ExtractionValidatorService verdict
  appliedToUser    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

// Every inbound Rubies webhook event, regardless of outcome — signature result
// included so a bad/unverifiable event is still auditable rather than silently
// dropped.
model RubiesWebhookEvent {
  id              String   @id @default(uuid())
  eventType       RubiesWebhookEventType
  rubiesReference String?
  rawPayload      Json
  signatureValid  Boolean  @default(false)
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([rubiesReference])
}

// Confirmed incoming credits (PRD #4a — incoming funds notification).
model IncomingCredit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amount          Decimal  @db.Decimal(14, 2)
  rubiesReference String   @unique
  sourceNarration String?
  creditedAt      DateTime
  createdAt       DateTime @default(now())
}

// Proactive nudge dedup (PRD #13 — post-v0, see plan Phase 9).
model NudgeLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         NudgeType
  sentAt       DateTime @default(now())
  channel      String   // "template" | "freeform"
  templateName String?

  @@index([userId, type, sentAt])
}
