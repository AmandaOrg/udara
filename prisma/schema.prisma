generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IncomeType {
  SALARIED
  FOUNDER
  MULTIPLE_STREAMS
}

enum BudgetMethod {
  FLAT
  PERCENTAGE
}

enum IncomePosture {
  RESTRICT // normal path: enforce tighter spending discipline
  GROW     // income-tier branch: not enough room to restrict further
}

enum OnboardingStage {
  DISCOVERY
  WELCOME
  IDENTITY
  MONEY_STORY
  AI_REFLECTION
  STRUCTURED_QUESTIONS
  PLAN_PROPOSED
  ACCOUNT_CREATED
  FUNDED
  FIRST_TRANSACTION
  COMPLETE
}

enum TransactionType {
  NORMAL        // inside window, within today's allowance
  EARLY_ACCESS  // outside 11am-8pm window
  BORROWED      // against future allowance
}

enum TransactionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  EXECUTED
  FAILED
  CANCELLED
}

enum RecipientLabel {
  RENT
  FOOD
  VENDOR
  OTHER
}

enum SettingsChangeType {
  WINDOW_HOURS
  OVERRIDE_FEES
  EXIT_RESTRICTIONS
  OTHER
}

enum SettingsChangeStatus {
  PENDING
  ELIGIBLE_FOR_REVIEW
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid())
  whatsappNumber    String   @unique
  rubiesAccountId   String?  @unique

  // Financial profile (captured at onboarding — section 7 / 7a of PRD)
  monthlyIncome     Decimal? @db.Decimal(14, 2)
  incomeType        IncomeType?
  incomePosture     IncomePosture @default(RESTRICT)
  budgetMethod      BudgetMethod  @default(FLAT)
  budgetPercentage  Decimal?      @db.Decimal(5, 4) // used when budgetMethod = PERCENTAGE
  strictnessLevel   Int?          // user-chosen strictness, 1-5 or similar scale

  // The stated goal captured at onboarding — quoted back by the Manager persona (section 7)
  statedGoal        String?
  statedGoalSetAt   DateTime?

  // Discipline window (defaults from env, overridable per-user)
  windowStartHour   Int      @default(11)
  windowEndHour     Int      @default(20)

  onboardingStage   OnboardingStage @default(DISCOVERY)
  onboardingCompletedAt DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dailyAllowances   DailyAllowance[]
  transactions      Transaction[]
  recipients        Recipient[]
  overrides         OverrideHistory[]
  settingsRequests  SettingsChangeRequest[]
  onboardingSessions OnboardingSession[]
}

// One row per user per calendar day — the heart of the discipline engine.
model DailyAllowance {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  date            DateTime @db.Date
  weekStartDate   DateTime @db.Date // Monday of the ISO week this allowance belongs to

  amountAllocated Decimal  @db.Decimal(14, 2)
  surplusCarriedIn Decimal @default(0) @db.Decimal(14, 2) // free rollover from prior day, same week only
  amountSpent     Decimal  @default(0) @db.Decimal(14, 2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, weekStartDate])
}

model Recipient {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  accountNumber     String
  bankCode          String
  accountName       String?
  label             RecipientLabel @default(OTHER)

  createdAt         DateTime @default(now())

  transactions      Transaction[]

  @@unique([userId, accountNumber, bankCode])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  recipientId     String
  recipient       Recipient @relation(fields: [recipientId], references: [id])

  amount          Decimal  @db.Decimal(14, 2)
  type            TransactionType @default(NORMAL)
  status          TransactionStatus @default(PENDING_CONFIRMATION)

  feeAmount       Decimal  @default(0) @db.Decimal(14, 2)

  rubiesReference String?  // external reference once executed via Rubies

  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  executedAt      DateTime?

  overrideHistory OverrideHistory?
}

// Denormalized record of every override applied — separate from Transaction
// so override behavior can be reported on independently (PRD success criteria).
model OverrideHistory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  type          TransactionType // EARLY_ACCESS or BORROWED
  feeAmount     Decimal  @db.Decimal(14, 2)
  waived        Boolean  @default(false) // true when covered by prior-day surplus

  createdAt     DateTime @default(now())
}

// The "Manager" escalation mechanic (section 7) — every settings-change
// request is timestamped against the 7-day minimum, regardless of framing.
model SettingsChangeRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  type          SettingsChangeType
  requestedChange String  // free text / structured payload describing the ask
  reason        String?  // what the user said when asked why

  requestedAt   DateTime @default(now())
  eligibleAt    DateTime // requestedAt + 7 days, computed at creation

  status        SettingsChangeStatus @default(PENDING)
  managerNotes  String?
  resolvedAt    DateTime?
}

// Raw conversation + extracted-field state for the onboarding flow.
model OnboardingSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  stage         OnboardingStage
  messages      Json     // [{ role, content, at }]
  extractedData Json?    // partial structured data as it's confirmed

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
