generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IncomeType {
  SALARIED
  FOUNDER
  MULTIPLE_STREAMS
}

enum BudgetMethod {
  FLAT
  PERCENTAGE
}

enum IncomePosture {
  RESTRICT // normal path: enforce tighter spending discipline
  GROW // income-tier branch: not enough room to restrict further
}

// Ordered to match the canonical Udara onboarding script's actual stage
// sequence (docs/Udara-Onboarding-Script), not alphabetically. Two additions
// vs the original Kedu script: FREQUENCY_CHECK (Stage 3b, a button follow-up
// on the "why did you come to me" answer — also absorbs what used to be a
// separate, near-duplicate structured question about unplanned-spending
// frequency) and PLAN_REVIEW (Stage 8's "does this feel right?" checkpoint,
// which didn't exist before). The account-creation/KYC step (PLAN_PROPOSED)
// now fires right after FREQUENCY_CHECK instead of at the very end — see
// OnboardingService for the full stage-machine.
enum OnboardingStage {
  DISCOVERY
  WELCOME
  // Terms + consequences shown, waiting on explicit consent. Sits between the
  // comprehension check and any data collection: nothing personal is asked
  // for until the user has agreed to what they're agreeing to.
  TERMS_CONSENT
  IDENTITY
  FREQUENCY_CHECK
  PLAN_PROPOSED
  MONEY_STORY
  AI_REFLECTION
  STRUCTURED_QUESTIONS
  PLAN_REVIEW
  ACCOUNT_CREATED
  FUNDED
  FIRST_TRANSACTION
  COMPLETE
}

enum TransactionType {
  NORMAL // inside window, within today's allowance
  EARLY_ACCESS // outside 11am-8pm window
  BORROWED // against future allowance
}

enum TransactionStatus {
  PENDING_CONFIRMATION
  // Confirm button tapped and all pre-flight guards passed, now waiting on
  // the user's PIN. Money has not moved and will not until the matching
  // PinChallenge is verified and consumed.
  PENDING_PIN
  CONFIRMED
  EXECUTED
  FAILED
  CANCELLED
}

enum RecipientLabel {
  RENT
  FOOD
  VENDOR
  OTHER
}

// The interactive (button/list-driven, non-AI) "send money" wizard's
// in-progress state — deliberately separate from ConversationSession, which
// is the AI-chat persona's history. This is a deterministic step machine,
// same design principle as OnboardingSession's stage field.
enum TransferDraftStep {
  AWAITING_AMOUNT
  AWAITING_ACCOUNT_NUMBER
  AWAITING_BANK_SELECTION
  AWAITING_LABEL_SELECTION // only reached for a brand-new recipient
  AWAITING_PURPOSE_NOTE // Other: user types what the send is for
}

enum TransferDraftStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BillPaymentCategory {
  AIRTIME
  DATA
  ELECTRICITY
}

enum BillPaymentDraftStep {
  AWAITING_TELCO
  AWAITING_AMOUNT
  AWAITING_MSISDN
  AWAITING_PRODUCT
  AWAITING_METER
  AWAITING_DISCO
}

enum BillPaymentDraftStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BillPaymentStatus {
  PENDING_CONFIRMATION
  PENDING_PIN
  CONFIRMED
  EXECUTED
  FAILED
  CANCELLED
}

enum SettingsChangeType {
  WINDOW_HOURS
  OVERRIDE_FEES
  EXIT_RESTRICTIONS
  OTHER
}

enum SettingsChangeStatus {
  PENDING
  ELIGIBLE_FOR_REVIEW
  APPROVED
  REJECTED
}

enum WhatsappMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappMessageType {
  TEXT
  BUTTON_REPLY
  LIST_REPLY
  // A WhatsApp Flow submission (interactive.nfm_reply) — the deterministic,
  // non-AI popup-form path for collecting KYC details (BVN/NIN + DOB +
  // email) at the Trust Moment. See OnboardingService.handleInboundFlowReply.
  FLOW_REPLY
  AUDIO
  IMAGE
  DOCUMENT
  LOCATION
  STATUS
  UNKNOWN
}

enum WhatsappMessageStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum ConversationPersona {
  KEDU
  MANAGER
}

enum ConversationSessionStatus {
  ACTIVE
  CLOSED
}

enum LlmCallPurpose {
  ONBOARDING_EXTRACTION
  CONVERSATION_REPLY
  MANAGER_REPLY
  TRANSFER_INTENT_PARSE
  INTENT_CLASSIFICATION
  ORCHESTRATOR_TURN
  OTHER
}

enum RubiesWebhookEventType {
  TRANSFER_STATUS
  INCOMING_CREDIT
  BILL_PAYMENT
  UNKNOWN
}

enum NudgeType {
  WINDOW_OPEN
  DAILY_SUMMARY
  BORROW_WARNING
  SETTINGS_ELIGIBLE
  HABIT_FORMING_FOLLOWUP // onboarding script stage 13 — ~10h after onboarding completes, once ever
  WEEKLY_REVIEW // Sunday in-chat spend recap + optional limit adjustment
  OTHER
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id              String  @id @default(uuid())
  whatsappNumber  String  @unique
  rubiesAccountId String? @unique

  // Identity captured during onboarding (Identity/AI Reflection stages, onboarding script)
  name        String?
  occupation  String?
  city        String?
  dateOfBirth DateTime? // collected at the Trust Moment specifically — Rubies KYC needs a real DOB, not just age

  // Legal name as entered on the Trust Moment KYC form (WhatsApp Flow) — kept
  // separate from `name` above, which is the friendly name from onboarding
  // chat and may not match the BVN/NIN record exactly. Rubies' 90%
  // name-similarity KYC match is against firstName/lastName only — it has no
  // middle-name field — so legalMiddleName is stored for our own records but
  // never sent to Rubies.
  legalFirstName  String?
  legalMiddleName String?
  legalLastName   String?
  email           String?

  // Financial profile (captured at onboarding — section 7 / 7a of PRD)
  monthlyIncome    Decimal?      @db.Decimal(14, 2)
  incomeType       IncomeType?
  incomePosture    IncomePosture @default(RESTRICT)
  budgetMethod     BudgetMethod  @default(FLAT)
  budgetPercentage Decimal?      @db.Decimal(5, 4) // used when budgetMethod = PERCENTAGE
  flatDailyAmount  Decimal?      @db.Decimal(14, 2) // used when budgetMethod = FLAT, set at PLAN_PROPOSED
  strictnessLevel  Int? // user-chosen strictness, 1-5 or similar scale

  // The stated goal captured at onboarding — quoted back by the Manager persona (section 7)
  statedGoal      String?
  statedGoalSetAt DateTime?

  // Discipline window (defaults from env, overridable per-user)
  windowStartHour Int @default(11)
  windowEndHour   Int @default(20)

  // Deliberate exit (PRD 4.1) — set only by ManagerConversationService once an
  // EXIT_RESTRICTIONS SettingsChangeRequest is APPROVED. While set, AllowanceService
  // bypasses window/fee enforcement entirely — this is what "account returns to
  // normal" means mechanically.
  disciplineExitedAt DateTime?

  // KYC fields required by Rubies wallet provisioning — exactly one of bvn/nin is used.
  bvn String?
  nin String?

  // Rubies wallet details returned by create-wallet — distinct from rubiesAccountId
  // (=customerId): accountNumber/accountName are what fund-transfer actually debits.
  rubiesAccountNumber String? @unique
  rubiesAccountName   String?
  rubiesBankCode      String?

  // Drives the WhatsApp 24h free-form-vs-template send decision.
  lastInboundMessageAt DateTime?

  onboardingStage       OnboardingStage @default(DISCOVERY)
  onboardingCompletedAt DateTime?

  // Transfer-authentication PIN. pinHash is a scrypt digest with its
  // parameters and per-user salt encoded inline (see PinService) — the PIN
  // itself is never stored, never logged, and never persisted on the
  // WhatsappMessage row that delivered it (see sensitive-fields.util.ts).
  // A 4-digit PIN is only a 10,000-key space, so pinFailedAttempts/
  // pinLockedUntil are the real defense, not the KDF.
  // A one-week override of the derived daily limit, set from the Sunday
  // weekly review. Scoped to a single WAT ISO week: AllowanceService ignores
  // it once dailyLimitOverrideWeekStart is no longer the current week, so the
  // plan automatically reverts to the 30%-of-income formula rather than
  // silently persisting a one-off adjustment forever.
  dailyLimitOverride          Decimal?  @db.Decimal(14, 2)
  dailyLimitOverrideWeekStart DateTime?

  // Explicit consent, captured at TERMS_CONSENT. Versioned so a future terms
  // change is distinguishable from "never consented" rather than being
  // silently grandfathered in.
  termsAcceptedAt DateTime?
  termsVersion    String?

  pinHash           String?
  pinSetAt          DateTime?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyAllowances      DailyAllowance[]
  transactions         Transaction[]
  recipients           Recipient[]
  transferDrafts       TransferDraft[]
  billPaymentDrafts    BillPaymentDraft[]
  billPayments         BillPayment[]
  overrides            OverrideHistory[]
  settingsRequests     SettingsChangeRequest[]
  onboardingSessions   OnboardingSession[]
  whatsappMessages     WhatsappMessage[]
  conversationSessions ConversationSession[]
  llmCallLogs          LlmCallLog[]
  incomingCredits      IncomingCredit[]
  nudgeLogs            NudgeLog[]
  pinChallenges        PinChallenge[]
  EmailLog             EmailLog[]
  WeeklyReview         WeeklyReview[]
}

// One row per user per calendar day — the heart of the discipline engine.
model DailyAllowance {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date          DateTime @db.Date
  weekStartDate DateTime @db.Date // Monday of the ISO week this allowance belongs to

  amountAllocated  Decimal @db.Decimal(14, 2)
  surplusCarriedIn Decimal @default(0) @db.Decimal(14, 2) // free rollover from prior day, same week only
  amountSpent      Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  billPayments BillPayment[]

  @@unique([userId, date])
  @@index([userId, weekStartDate])
}

model Recipient {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  accountNumber String
  bankCode      String
  accountName   String?
  label         RecipientLabel @default(OTHER)
  // User-facing name for repeat sends ("james", "landlord") — not a bank field.
  nickname   String?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  transactions Transaction[]

  @@unique([userId, accountNumber, bankCode])
  @@index([userId, nickname])
}

model TransferDraft {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  step   TransferDraftStep
  status TransferDraftStatus @default(ACTIVE)

  amount         Decimal?        @db.Decimal(14, 2)
  accountNumber  String?
  bankCode       String?
  bankName       String?
  resolvedName   String? // from Rubies name-enquiry, shown back to the user for confirmation
  isNewRecipient Boolean         @default(false)
  label          RecipientLabel?
  purposeNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model BillPaymentDraft {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  category BillPaymentCategory @default(AIRTIME)
  step     BillPaymentDraftStep
  status   BillPaymentDraftStatus @default(ACTIVE)

  billerCode  String?
  productCode String?
  telcoLabel  String?
  productLabel String?
  customerName String?
  amount      Decimal? @db.Decimal(14, 2)
  msisdn      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model BillPayment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  category    BillPaymentCategory @default(AIRTIME)
  billerCode  String
  productCode String
  telcoLabel  String
  productLabel String?
  customerName String?
  msisdn      String
  amount      Decimal           @db.Decimal(14, 2)
  type        TransactionType   @default(NORMAL)
  status      BillPaymentStatus @default(PENDING_CONFIRMATION)

  feeAmount Decimal @default(0) @db.Decimal(14, 2)

  rubiesReference   String?
  vendorToken       String?
  requestReference  String? @unique
  idempotencyKey    String? @unique

  dailyAllowanceId     String?
  dailyAllowance       DailyAllowance? @relation(fields: [dailyAllowanceId], references: [id])
  appliedToAllowanceAt DateTime?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  executedAt  DateTime?

  pinChallenges PinChallenge[]

  @@index([userId, status])
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id])

  amount Decimal           @db.Decimal(14, 2)
  type   TransactionType   @default(NORMAL)
  status TransactionStatus @default(PENDING_CONFIRMATION)
  // This send's stated purpose (spend-check / orchestrator label_hint) — may
  // differ from Recipient.label when the person was tagged on an earlier send.
  purposeLabel RecipientLabel?
  purposeNote  String?

  feeAmount         Decimal   @default(0) @db.Decimal(14, 2)
  // Set once the feeAmount (if any) has actually been moved to
  // RUBIES_FEES_ACCOUNT_NUMBER — separate from feeAmount/type, which are
  // computed at confirm-time regardless of whether the sweep transfer
  // itself later succeeds. See TransferConfirmationService.sweepFeeToFeesAccount.
  feeSweptAt        DateTime?
  feeSweepReference String?

  rubiesReference String? // external reference once executed via Rubies

  // Idempotency / allowance-application linkage — makes recordSpend safe to call twice
  // and ties a spend to the exact button-confirm that authorized it.
  dailyAllowanceId     String?
  dailyAllowance       DailyAllowance? @relation(fields: [dailyAllowanceId], references: [id])
  appliedToAllowanceAt DateTime?
  idempotencyKey       String?         @unique
  whatsappMessageId    String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  executedAt  DateTime?

  overrideHistory OverrideHistory?
}

// Denormalized record of every override applied — separate from Transaction
// so override behavior can be reported on independently (PRD success criteria).
model OverrideHistory {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  type      TransactionType // EARLY_ACCESS or BORROWED
  feeAmount Decimal         @db.Decimal(14, 2)
  waived    Boolean         @default(false) // true when covered by prior-day surplus

  createdAt DateTime @default(now())
}

// The "Manager" escalation mechanic (section 7) — every settings-change
// request is timestamped against the 7-day minimum, regardless of framing.
model SettingsChangeRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type            SettingsChangeType
  requestedChange String // free text / structured payload describing the ask
  reason          String? // what the user said when asked why

  requestedAt DateTime @default(now())
  eligibleAt  DateTime // requestedAt + 7 days, computed at creation

  // PRD §7: "a real delay is part of the design... not an instant reply — even a few
  // hours... gives the impulse room to pass." Separate from and in addition to the
  // hard `eligibleAt` gate above — this governs only the initial acknowledgment reply,
  // not eligibility for a decision. Durable (DB-backed, not an in-memory timer) so it
  // survives a process restart between filing and the scheduled reply.
  initialReplyDueAt  DateTime?
  initialReplySentAt DateTime?

  status       SettingsChangeStatus @default(PENDING)
  managerNotes String?
  resolvedAt   DateTime?
}

// Raw conversation + extracted-field state for the onboarding flow.
model OnboardingSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  stage         OnboardingStage
  messages      Json // [{ role, content, at }]
  extractedData Json? // partial structured data as it's confirmed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging, AI audit trail, and Rubies inbound models
// ---------------------------------------------------------------------------

// Inbound/outbound WhatsApp message log. waMessageId is the real dedup key —
// Meta redelivers webhooks, and this unique constraint is what makes processing
// idempotent.
model WhatsappMessage {
  id               String                   @id @default(uuid())
  userId           String?
  user             User?                    @relation(fields: [userId], references: [id])
  waMessageId      String                   @unique
  direction        WhatsappMessageDirection
  type             WhatsappMessageType
  fromNumber       String
  textBody         String?
  buttonPayload    String? // button/list id picked
  mediaId          String? // Meta media id for audio/image/doc — plumbing only, no download in v0
  mediaMimeType    String?
  transcript       String? // filled in by the transcription fast-follow, not v0
  flowResponseJson Json? // parsed interactive.nfm_reply.response_json for FLOW_REPLY rows
  rawPayload       Json
  status           WhatsappMessageStatus    @default(RECEIVED)
  createdAt        DateTime                 @default(now())
  processedAt      DateTime?

  @@index([userId, createdAt])
}

// Post-onboarding conversation state. OnboardingSession stays dedicated to the
// stage machine; everything after COMPLETE uses this instead.
model ConversationSession {
  id          String                    @id @default(uuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id])
  persona     ConversationPersona       @default(KEDU)
  status      ConversationSessionStatus @default(ACTIVE)
  messages    Json // rolling window, same {role,content,at} shape as OnboardingSession
  contextData Json? // pending transfer draft, last classified intent, etc.
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([userId, status])
}

// The AI audit trail — "every output is a proposal, never a command." Every
// LlmService.complete() call is logged here, raw proposal separate from
// whatever validation/write actually happened as a result.
model LlmCallLog {
  id               String         @id @default(uuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  purpose          LlmCallPurpose
  provider         String
  model            String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  rawResponse      Json // the model's raw proposal — distinct from what was actually written
  validationResult Json? // ExtractionValidatorService verdict
  appliedToUser    Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([userId, purpose, createdAt])
}

// Every inbound Rubies webhook event, regardless of outcome — signature result
// included so a bad/unverifiable event is still auditable rather than silently
// dropped.
model RubiesWebhookEvent {
  id              String                 @id @default(uuid())
  eventType       RubiesWebhookEventType
  rubiesReference String?
  rawPayload      Json
  signatureValid  Boolean                @default(false)
  processedAt     DateTime?
  createdAt       DateTime               @default(now())

  @@index([rubiesReference])
}

// Confirmed incoming credits (PRD #4a — incoming funds notification).
model IncomingCredit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amount          Decimal  @db.Decimal(14, 2)
  rubiesReference String   @unique
  sourceNarration String?
  creditedAt      DateTime
  createdAt       DateTime @default(now())
}

// Proactive nudge dedup (PRD #13 — post-v0, see plan Phase 9).
model NudgeLog {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  type         NudgeType
  sentAt       DateTime  @default(now())
  channel      String // "template" | "freeform"
  templateName String?

  @@index([userId, type, sentAt])
}

// ---------------------------------------------------------------------------
// PIN authentication
// ---------------------------------------------------------------------------

enum PinChallengePurpose {
  SETUP
  TRANSFER_AUTH
  RESET
}

// Binds one PIN-entry Flow send to one specific action, single-use. Without
// this, a replayed Flow reply could authorize a *different* transfer than the
// one the user actually looked at: flowToken was previously generated on every
// sendFlow and never checked on the way back in.
model PinChallenge {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  flowToken     String              @unique
  purpose       PinChallengePurpose
  transactionId String? // null for SETUP, RESET, and bill-pay PIN
  billPaymentId String?
  billPayment   BillPayment? @relation(fields: [billPaymentId], references: [id])

  // RESET only. The emailed one-time code, hashed with the same scrypt path
  // as the PIN itself — a 6-digit code is a 1,000,000-key space, so it is
  // never stored in the clear. otpAttempts bounds guessing: a wrong code
  // carries the same hash forward onto a fresh single-use challenge (so the
  // emailed code keeps working) with the count incremented, and the reset
  // dies once the ceiling is hit.
  otpHash     String?
  otpAttempts Int     @default(0)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Email notifications (Resend)
// ---------------------------------------------------------------------------

enum EmailType {
  PIN_RESET_OTP
  MONEY_IN
  MONEY_OUT
  WINDOW_OPEN
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED // no address on file, or email disabled for this environment
}

// One row per attempted send, successes and failures alike, so a missing
// email is diagnosable after the fact rather than invisible.
//
// dedupeKey is the idempotency guard and carries the real "send once"
// semantics — same pattern as Transaction.idempotencyKey and
// WhatsappMessage.waMessageId. It encodes what the email is *about* (a
// specific credit, a specific transaction, a specific user-week), so a
// retried webhook or an overlapping scheduler tick collides on the unique
// index instead of sending twice.
model EmailLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type       EmailType
  toAddress  String
  subject    String
  status     EmailStatus
  dedupeKey  String      @unique
  providerId String? // Resend's message id, for tracing a delivery back
  error      String?

  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

// ---------------------------------------------------------------------------
// Sunday weekly review (in-chat)
// ---------------------------------------------------------------------------

enum WeeklyReviewStatus {
  SENT // recap delivered, waiting on the keep/adjust choice
  AWAITING_LIMIT // user chose "adjust", next text is their new daily limit
  COMPLETED // kept, accepted a new limit, or abandoned the wait
}

// One review per user per WAT ISO week. The unique constraint is what makes
// the Sunday scheduler safe to re-run: a second tick in the same week hits
// the constraint rather than sending a duplicate recap.
model WeeklyReview {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  weekStartDate DateTime // WAT ISO week the recap covers
  status        WeeklyReviewStatus @default(SENT)
  totalSpent    Decimal            @db.Decimal(14, 2)
  newDailyLimit Decimal?           @db.Decimal(14, 2) // set only if they adjusted

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  @@unique([userId, weekStartDate])
  @@index([userId, status])
}
